[Unit]
Description=Herdr visited-agent history tracker (local default session)
ConditionFileIsExecutable=%h/code/herdr-agent-history/herdr-agent-history

[Service]
Type=simple
WorkingDirectory=%h/code/herdr-agent-history
ExecStart=%h/code/herdr-agent-history/herdr-agent-history track --socket=%h/.config/herdr/herdr.sock --state-dir=%h/.local/state/herdr/plugins/local.agent-history
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
